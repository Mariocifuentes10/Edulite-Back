{
  "name": "edulite-backend",
  "version": "1.0.0",
  "description": "API REST de EduLite: plataforma educativa offline y de bajo consumo de datos",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "local": "node scripts/arrancar-local.js",
    "test": "jest",
    "test:e2e": "jest --config jest.e2e.config.js"
  },
  "keywords": [
    "educacion",
    "api",
    "express",
    "offline"
  ],
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/e2e/"
    ],
    "clearMocks": true
  },
  "engines": {
    "node": ">=18"
  }
}
