# Entorno de ejecución: development | test | production
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Origen permitido por CORS (el frontend Angular en desarrollo)
CORS_ORIGIN=http://localhost:4200

# Conexión a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edulite

# Seguridad JWT (mínimo 32 caracteres; generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio-de-32-caracteres-minimo

# Expiración del token (formato de jsonwebtoken: 60s, 30m, 12h, 7d)
JWT_EXPIRES_IN=7d

# Rondas de bcrypt (mínimo 10)
BCRYPT_ROUNDS=10
